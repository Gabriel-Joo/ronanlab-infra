  {
   "type": "timeseries",
   "title": "요청 수(초당, 상태코드별)",
   "description": "ingress-nginx 기준 — 앱에 /metrics 가 없어 입구에서 센다. WebSocket 은 연결 한 번이 요청 하나",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (status) (rate(nginx_ingress_controller_requests{host=\"petmint.ronanlab.dev\"}[5m]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
