  {
   "type": "barchart",
   "title": "시간대별 질문 수(KST)",
   "description": "고른 기간 전체를 시(0~23)별로 합친 것. DB 는 UTC 라 +9시간",
   "targets": [
    {
     "datasource": {
      "type": "mysql",
      "uid": "petmint-mysql"
     },
     "rawSql": "SELECT LPAD(HOUR(DATE_ADD(created_at, INTERVAL 9 HOUR)), 2, '0') AS `시(KST)`, COUNT(*) AS `질문`\nFROM turns WHERE $__timeFilter(created_at)\nGROUP BY 1 ORDER BY 1",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "refId": "A"
    }
   ],
   "options": {
    "orientation": "auto",
    "showValue": "auto",
    "legend": {
     "showLegend": false
    }
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "id": 8,
   "gridPos": {
    "h": 8,
    "w": 10,
    "x": 14,
    "y": 8
