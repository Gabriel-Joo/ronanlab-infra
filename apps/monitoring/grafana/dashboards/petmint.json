  {
   "type": "timeseries",
   "title": "에러율(5xx 비율)",
   "description": "ingress-nginx 기준 5xx / 전체",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(nginx_ingress_controller_requests{host=\"petmint.ronanlab.dev\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(nginx_ingress_controller_requests{host=\"petmint.ronanlab.dev\"}[5m])), 1e-9)",
