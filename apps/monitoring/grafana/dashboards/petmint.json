  {
   "type": "timeseries",
   "title": "모드별 질문 수(시간당)",
   "description": "일반 · 사내규정 · 업무특화. 턴 = 질문 하나",
   "targets": [
    {
     "datasource": {
      "type": "mysql",
      "uid": "petmint-mysql"
     },
     "rawSql": "SELECT $__timeGroupAlias(t.created_at, '1h'), s.mode AS metric, COUNT(*) AS value\nFROM turns t JOIN sessions s ON s.session_id = t.session_id\nWHERE $__timeFilter(t.created_at)\nGROUP BY 1, 2 ORDER BY 1",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 7,
   "gridPos": {
    "h": 8,
    "w": 14,
    "x": 0,
    "y": 8
   }
