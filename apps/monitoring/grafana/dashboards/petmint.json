  {
   "type": "timeseries",
   "title": "응답 시간 p50 / p90(일별)",
   "description": "turns.latency_ms(답 끝까지) · first_token_ms(첫 토큰까지), status=ok 만. MySQL 에 분위수 함수가 없어 PERCENT_RANK 로",
   "targets": [
    {
     "datasource": {
      "type": "mysql",
      "uid": "petmint-mysql"
     },
     "rawSql": "SELECT TIMESTAMP(d) AS time,\n  MAX(CASE WHEN pr <= 0.5 THEN v END) / 1000 AS `전체 p50`,\n  MAX(CASE WHEN pr <= 0.9 THEN v END) / 1000 AS `전체 p90`\nFROM (SELECT DATE(created_at) AS d, latency_ms AS v,\n        PERCENT_RANK() OVER (PARTITION BY DATE(created_at) ORDER BY latency_ms) AS pr\n      FROM turns WHERE status = 'ok' AND latency_ms IS NOT NULL AND $__timeFilter(created_at)) x\nGROUP BY d ORDER BY d",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "mysql",
      "uid": "petmint-mysql"
     },
     "rawSql": "SELECT TIMESTAMP(d) AS time,\n  MAX(CASE WHEN pr <= 0.5 THEN v END) / 1000 AS `첫 토큰 p50`,\n  MAX(CASE WHEN pr <= 0.9 THEN v END) / 1000 AS `첫 토큰 p90`\nFROM (SELECT DATE(created_at) AS d, first_token_ms AS v,\n        PERCENT_RANK() OVER (PARTITION BY DATE(created_at) ORDER BY first_token_ms) AS pr\n      FROM turns WHERE status = 'ok' AND first_token_ms IS NOT NULL AND $__timeFilter(created_at)) x\nGROUP BY d ORDER BY d",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
