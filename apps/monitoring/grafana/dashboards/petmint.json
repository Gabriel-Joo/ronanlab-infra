    "w": 9,
    "x": 6,
    "y": 17
   }
  },
  {
   "type": "piechart",
   "title": "코드 답 vs 모델 답",
   "description": "code_rule 이 있으면 코드 답",
   "targets": [
    {
     "datasource": {
      "type": "mysql",
      "uid": "petmint-mysql"
     },
     "rawSql": "SELECT CASE WHEN code_rule IS NULL THEN '모델 답' ELSE '코드 답' END AS `종류`, COUNT(*) AS `턴`\nFROM turns WHERE $__timeFilter(created_at)\nGROUP BY 1",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "refId": "A"
