  {
   "type": "timeseries",
   "title": "거절률(일별)",
   "description": "turns.refused(2026-11-11~) — 답이 거절 문구인 턴 / status=ok 턴. 판정은 평가와 같은 함수(앱 data/refusal.py). 코드 답 턴도 들어간다(코드 답은 거절 문구를 쓰지 않는다). 그 전 턴은 NULL이라 빠진다",
   "targets": [
    {
     "datasource": {
      "type": "mysql",
      "uid": "petmint-mysql"
     },
     "rawSql": "SELECT $__timeGroupAlias(t.created_at, '1d'), s.mode AS metric, AVG(t.refused) AS value\nFROM turns t JOIN sessions s ON s.session_id = t.session_id\nWHERE t.refused IS NOT NULL AND $__timeFilter(t.created_at)\nGROUP BY 1, 2 ORDER BY 1",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 10,
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 0,
    "y": 17
   }
  },
  {
   "type": "barchart",
   "title": "규칙별 발동 수(code_rule)",
   "description": "코드가 약관 기준으로 직접 답한 턴의 규칙 이름",
   "targets": [
    {
     "datasource": {
      "type": "mysql",
      "uid": "petmint-mysql"
     },
     "rawSql": "SELECT code_rule AS `규칙`, COUNT(*) AS `발동`\nFROM turns\nWHERE code_rule IS NOT NULL AND $__timeFilter(created_at)\nGROUP BY 1 ORDER BY 2 DESC",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "refId": "A"
    }
   ],
   "options": {
    "orientation": "auto",
    "showValue": "auto",
    "legend": {
     "showLegend": false
    }
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
