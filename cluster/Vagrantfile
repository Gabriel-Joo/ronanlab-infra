IMAGE_NAME = "generic/ubuntu2204"

NODES = [
  { name: "m-k8s",  ip: "192.168.122.10", cpus: 2, memory: 4096 },
  { name: "w1-k8s", ip: "192.168.122.11", cpus: 2, memory: 8192 },   # 2026-11-10 4096 → 8192
  { name: "w2-k8s", ip: "192.168.122.12", cpus: 2, memory: 8192 },   # 2026-11-10 4096 → 8192
  { name: "w3-k8s", ip: "192.168.122.13", cpus: 2, memory: 8192 },   # 2026-11-10 4096 → 8192
  # 2026-11-10 가용성 묶음 1 — 플랫폼 노드(Prometheus · Grafana · Loki 자리, 배치 고정은 묶음 2). k8s 설치는 setup-node.sh(버전 1.35.9-1.1 고정) → kubeadm join
  { name: "w4-k8s", ip: "192.168.122.14", cpus: 2, memory: 8192 },
]

Vagrant.configure("2") do |config|
  NODES.each do |node|
    config.vm.define node[:name] do |n|
      n.vm.box = IMAGE_NAME
      n.vm.hostname = node[:name]
      n.vm.network "private_network", ip: node[:ip]

      n.vm.provider :libvirt do |lv|
        lv.cpus = node[:cpus]
        lv.memory = node[:memory]
        lv.machine_virtual_size = 20
      end

      # 박스 기본 DNS(4.2.2.x, DNSSEC=yes)가 이 망에서 잘 안 풀린다 — 2026-10-13 m · w1~w3 에 손으로 넣은 것을 2026-11-10 w4 를 만들며 여기로 옮겼다
      n.vm.provision "shell", inline: <<-SHELL
        mkdir -p /etc/systemd/resolved.conf.d
        printf '[Resolve]\\nDNS=8.8.8.8 1.1.1.1\\nFallbackDNS=8.8.4.4\\nDNSSEC=no\\n' > /etc/systemd/resolved.conf.d/dns.conf
        systemctl restart systemd-resolved
      SHELL

      # containerd 가 Harbor 를 공개 DNS(Cloudflare Access)로 풀지 않게 — ingress-nginx 의 MetalLB VIP 로 고정.
      # 옛 줄(192.168.121.179 = w1 의 NAT 망 DHCP 주소)이 있어도 바꿔 쓴다
      n.vm.provision "shell", inline: <<-SHELL
        sed -i '/[[:space:]]harbor\\.ronanlab\\.dev$/d' /etc/hosts
        echo "192.168.122.240 harbor.ronanlab.dev" >> /etc/hosts
      SHELL

      # 약관 볼륨이 호스트(192.168.122.1) NFS 읽기 전용 PV 다 — kubelet 이 마운트하려면 워커에 mount.nfs 가 있어야 한다
      if node[:name] != "m-k8s"
        n.vm.provision "shell", inline: <<-SHELL
          dpkg -s nfs-common >/dev/null 2>&1 || { apt-get -qq update && DEBIAN_FRONTEND=noninteractive apt-get -qq install -y nfs-common; }
        SHELL
      end
    end
  end
end
